diff --git a/app/src/alpha/AndroidManifest.xml b/app/src/alpha/AndroidManifest.xml
new file mode 100644
--- /dev/null
+++ b/app/src/alpha/AndroidManifest.xml
@@ -0,0 +1,18 @@
+<manifest xmlns:android="http://schemas.android.com/apk/res/android">
+    <application>
+        <activity android:name=".ExternalControlActivity">
+            <intent-filter>
+                <action android:name="com.github.just.clash.alpha.action.START_CLASH" />
+                <category android:name="android.intent.category.DEFAULT" />
+            </intent-filter>
+            <intent-filter>
+                <action android:name="com.github.just.clash.alpha.action.STOP_CLASH" />
+                <category android:name="android.intent.category.DEFAULT" />
+            </intent-filter>
+            <intent-filter>
+                <action android:name="com.github.just.clash.alpha.action.TOGGLE_CLASH" />
+                <category android:name="android.intent.category.DEFAULT" />
+            </intent-filter>
+        </activity>
+    </application>
+</manifest>
